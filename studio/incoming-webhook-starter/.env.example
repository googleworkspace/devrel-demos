# Server Configuration
PORT=8080
PUBLIC_BASE_URL=https://your-domain.example.com
COOKIE_SECRET=replace-with-a-random-secure-cookie-secret

# Google OAuth 2.0 Web App (User Authorization)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-web-client-secret

# Google Workspace Studio Add-on Verification
# The service account email and client ID associated with your Google Workspace Add-on deployment
GOOGLE_ADDON_SERVICE_ACCOUNT_EMAIL=your-addon-service-account@example.iam.gserviceaccount.com
GOOGLE_ADDON_CLIENT_ID=your-addon-client-id.apps.googleusercontent.com

# Database Path (Optional, defaults to webhook_bridge.sqlite)
DATABASE_PATH=webhook_bridge.sqlite
