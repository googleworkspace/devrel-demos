{
	"name": "webhook-studio-addon",
	"version": "1.0.0",
	"description": "Generic Incoming Webhook Bridge Starter for Google Workspace Studio (TypeScript + Express + Drizzle ORM + better-sqlite3)",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"build": "tsc",
		"start": "node --env-file-if-exists=.env dist/server.js",
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"db:generate": "drizzle-kit generate",
		"db:push": "tsx src/db/push.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"cookie-parser": "^1.4.7",
		"drizzle-orm": "^0.45.2",
		"express": "^4.21.2",
		"google-auth-library": "^9.15.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/better-sqlite3": "^7.6.12",
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.0",
		"@types/node": "^22.13.4",
		"@types/supertest": "^6.0.2",
		"drizzle-kit": "^0.30.4",
		"supertest": "^7.0.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vitest": "^3.0.6"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true
	}
}
